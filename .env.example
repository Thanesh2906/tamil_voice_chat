# Copy to .env locally. Never commit .env or put provider keys in browser/mobile
# storage, chat, NEXT_PUBLIC_* variables, or build arguments. See infra/SETUP.md.
JARVIS_ENV=development
JARVIS_LOG_LEVEL=info

# Postgres. Generate unique values for deployment; these are not credentials.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
# DATABASE_URL=sqlite+pysqlite:///./jarvis-dev.db
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jarvis_chunks

# Local Ollama is configured, not verified. Pull/test the selected model first.
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.1:8b-instruct-q5_K_M
# Explicit data-transfer consent is still required for every cloud provider.
LLM_ALLOW_CLOUD=false

# API accounts/keys and API billing are separate from consumer subscriptions.
# All model names are configurable examples, not a promise of account access.
# Obtain keys from the providers' official developer consoles.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct
# Groq inference and Grok (xAI) are different services with different keys.
# GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# XAI_API_KEY=
XAI_MODEL=grok-4.7

# Optional vLLM/llama.cpp/OpenAI-compatible runtime. Include /v1 if required.
# Both BASE_URL and MODEL must be set before it appears as configured.
# SELF_HOSTED_BASE_URL=http://your-private-runtime:8000/v1
# SELF_HOSTED_MODEL=your-deployed-model-id
# SELF_HOSTED_API_KEY=
# Keep false unless the operator has verified the endpoint is privately owned,
# on a trusted network, and does not proxy requests to a third-party service.
# This is an operator assertion, not automatic detection or a network sandbox.
SELF_HOSTED_LOCAL=false

# STT and TTS still require installed models and real-device verification.
STT_MODEL=small
STT_LANGUAGE=auto
STT_COMPUTE_TYPE=int8
TTS_ENGINE=piper
# For Piper, replace this placeholder with an actual provisioned ONNX voice path.
TTS_VOICE=ta-IN-default
PROMETHEUS_URL=http://prometheus:9090
STT_URL=http://stt:8000
TTS_URL=http://tts:8000
RAG_URL=http://rag:8000
MONITORING_URL=http://monitoring:8000

# Generate your own 32+ character value. Never deploy development defaults.
JWT_SECRET=development-only-change-me-secret-32bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Set a separate strong Grafana password before starting Compose.
GRAFANA_ADMIN_PASSWORD=

# JSON arrays are required (comma-separated values are not Settings JSON).
# Next.js uses :3001; :3000 is reserved for localhost-only Grafana.
ALLOWED_ORIGINS=["http://localhost:8080","http://localhost:5173","http://localhost:3001"]
# API only binds loopback by default; place an authenticated TLS proxy in front.
API_BIND_ADDRESS=127.0.0.1
AUDIO_SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
MAX_AUDIO_BYTES=1920000

# Compose mounts an empty named workspace at /workspace. These paths are inside
# the containers; listing a host path here does not mount it. See infra/SETUP.md.
# Direct host development should set this to an explicit local project path.
RAG_ALLOWED_ROOTS=["/workspace"]

# Optional development bootstrap. Never set in production.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=

# Host command/SSH execution is NOT an OS sandbox. Disabled by default; enabling
# it requires an isolated deployment and administrative access. Approval still
# applies, but a working-directory allowlist cannot confine arbitrary programs.
TOOLS_UNSAFE_HOST_EXECUTION=false

# Other privileged adapters are deny-by-default and require bounded allowlists.
# Compose deliberately mounts no Docker socket, SSH keys or host filesystem.
DOCKER_ALLOWED_CONTAINERS=[]
# GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=[]
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=bot@example.com
# SMTP_PASSWORD=
# SMTP_FROM=bot@example.com
EMAIL_ALLOWED_RECIPIENTS=[]
SSH_ALLOWED_HOSTS=[]
