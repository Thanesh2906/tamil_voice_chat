 JARVIS_ENV=development
JARVIS_JWT_SECRET=replace-with-at-least-32-random-characters
JARVIS_DATABASE_PATH=data/jarvis.db
JARVIS_ALLOWED_RAG_ROOTS=./workspace
JARVIS_CORS_ORIGINS=http://localhost:8080
JARVIS_LLM_URL=http://llm:11434
JARVIS_STT_URL=http://stt:8001
JARVIS_TTS_URL=http://tts:8002
JARVIS_RAG_URL=http://rag:8003
JARVIS_MONITORING_URL=http://monitoring:8004

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me
# DATABASE_URL=postgresql+psycopg://jarvis:replace-me@postgres:5432/jarvis

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jarvis_chunks

# LLM (Ollama-compatible, local/private default; always available)
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.1:8b-instruct-q5_K_M

# Multi-model router (services/llm/router.py). Cloud providers register only when
# their key below is set. RAG and monitoring modes always stay on Ollama (project
# documents / infra data never leave this host) unless you flip LLM_ALLOW_CLOUD or
# a request explicitly overrides it. "personal" and "coding" modes will use a
# configured cloud model once LLM_ALLOW_CLOUD=true.
LLM_ALLOW_CLOUD=false

# Claude (Anthropic). Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ChatGPT (OpenAI). Get a key at https://platform.openai.com/
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Gemini (Google). Get a key at https://aistudio.google.com/
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenRouter: the practical way to reach large open-weight models (70B-400B
# class, e.g. Llama 3.1 405B, Qwen2.5-72B, DeepSeek) without self-hosting them.
# Get a key at https://openrouter.ai/
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-405b-instruct

# STT (faster-whisper)
STT_MODEL=small
STT_LANGUAGE=auto
STT_COMPUTE_TYPE=int8

# TTS
TTS_ENGINE=piper
TTS_VOICE=ta-IN-default

# Monitoring
PROMETHEUS_URL=http://prometheus:9090

# Internal service discovery
STT_URL=http://stt:8000
TTS_URL=http://tts:8000
RAG_URL=http://rag:8000
MONITORING_URL=http://monitoring:8000

# Auth
JWT_SECRET=development-only-change-me-secret-32bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# CORS / origins
# Include the Next.js dev server origin (apps/web-next, "npm run dev" defaults to :3000)
# or the browser console will show CORS errors when the frontend calls this API.
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Audio
AUDIO_SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
MAX_AUDIO_BYTES=1920000

# JSON list or deployment-specific settings source. Only these roots may be indexed by RAG
# AND are the only paths the tool gateway (list_dir/read_file/search_text/write_file/
# git_status/git_diff/run_command's cwd) may touch. Point this at your real project folder(s)
# to let Jarvis read and, after your approval, write inside them.
RAG_ALLOWED_ROOTS=["/workspace"]

# Optional development bootstrap. Never set in production.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.test
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-password

# ---- High-privilege tool adapters (services/tools) -------------------------
# Every allowlist below is empty by default: deny by default, nothing is
# reachable until you explicitly name it here. Writes/exec still pause for
# your approval in the tool gateway regardless of what you allow below --
# these bound what can ever be *proposed*, not whether you still confirm it.

# Docker write actions (start/stop/restart) -- exact container names/IDs.
# JSON list, e.g. DOCKER_ALLOWED_CONTAINERS=["jarvis-api-1","jarvis-llm-1"]
DOCKER_ALLOWED_CONTAINERS=[]

# GitHub: a token scoped to only the repos you list below (a fine-grained PAT
# limited to those repos is strongly preferred over a classic all-repo token).
# GITHUB_TOKEN=
# JSON list of "owner/repo", e.g. GITHUB_ALLOWED_REPOS=["you/your-project"]
GITHUB_ALLOWED_REPOS=[]

# Outbound email via SMTP.
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
# SMTP_USERNAME=bot@example.com
# SMTP_PASSWORD=
# SMTP_FROM=bot@example.com
# JSON list: exact addresses or a "*@domain" wildcard for a whole domain.
# EMAIL_ALLOWED_RECIPIENTS=["you@example.com","*@your-team.example.com"]
EMAIL_ALLOWED_RECIPIENTS=[]

# SSH: "user@host" or "host" entries this machine already trusts (its
# known_hosts must already have the host key -- this never auto-accepts an
# unknown host on first connect). Commands are restricted to the same
# allowlist as the local run_command tool (git/pytest/python/npm/ruff/...).
# JSON list, e.g. SSH_ALLOWED_HOSTS=["deploy@prod.example.com"]
SSH_ALLOWED_HOSTS=[]
