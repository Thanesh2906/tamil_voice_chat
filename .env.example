# Copy to .env and fill in. Never commit secrets.
JARVIS_ENV=dev
JARVIS_LOG_LEVEL=info

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jarvis
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=change-me

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=jarvis_chunks

# LLM (Ollama-compatible)
LLM_BASE_URL=http://llm:11434
LLM_MODEL=llama3.1:8b-instruct-q5_K_M

# STT (faster-whisper)
STT_MODEL=small
STT_LANGUAGE=auto
STT_COMPUTE_TYPE=int8

# TTS
TTS_ENGINE=piper
TTS_VOICE=ta-IN-default

# Monitoring
PROMETHEUS_URL=http://prometheus:9090

# Auth
JWT_SECRET=change-me-32-bytes-or-more
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# CORS / origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Audio
AUDIO_SAMPLE_RATE=16000
VAD_AGGRESSIVENESS=2
